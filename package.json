{
  "name": "google-oauth2-env-vars",
  "version": "2.0.0",
  "description": "Generate and cache Google OAuth 2.0 tokens in .env files",
  "repository": "https://github.com/cedricdelpoux/google-oauth2-env-vars",
  "author": {
    "name": "Cédric Delpoux",
